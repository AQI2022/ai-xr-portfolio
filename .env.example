# Default uses local, deterministic retrieval. It is explicitly labelled, not a fake LLM.
AI_PROVIDER=extractive
AI_DATA_DIR=data
# For a self-hosted or OpenAI-compatible chat endpoint:
AI_LLM_BASE_URL=http://127.0.0.1:11434/v1
AI_LLM_MODEL=qwen2.5:0.5b
AI_LLM_API_KEY=
# Set AI_PROVIDER=transformers for the local downloaded Qwen model.
AI_LOCAL_MODEL=models/qwen2.5-0.5b-instruct
AI_EMBEDDING_MODEL=
AI_RERANKER_MODEL=
AI_YOLO_MODEL=models/yolo11n.pt
# Optional Brave search API; pasted job descriptions work without it.
AI_SEARCH_API_KEY=
# Set a secret before exposing the API beyond your own computer.
AI_APP_API_KEY=
AI_MAX_UPLOAD_BYTES=10485760
